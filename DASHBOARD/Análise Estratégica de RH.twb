          <datasource-dependencies datasource='federated.0v5cqpn0mtcjdm1ggqrz914n2u6b'>
            <column caption='campo de risco ' datatype='string' name='[Calculation_1070167215144962]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Engagement_Score] &lt; 2.8 &#13;&#10;AND [Work_Life_Balance_Score] &lt; 2.9 &#13;&#10;THEN &quot;Alto Risco&quot;&#13;&#10;ELSE &quot;Baixo Risco&quot;&#13;&#10;END' />
